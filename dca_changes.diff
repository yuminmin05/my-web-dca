index 0000000..aebd6f0
--- /dev/null
+++ b/dashboard/optimizers/mean_variance.py
@@ -0,0 +1,92 @@
+import logging
+
+import numpy as np
+import pandas as pd
+import yfinance as yf
+
+from .base import BaseOptimizer
+
+logger = logging.getLogger(__name__)
+
+
+class MeanVarianceOptimizer(BaseOptimizer):
+    """Classic Markowitz mean-variance (max-Sharpe / tangency portfolio) optimizer.
+
+    ใช้เป็นโมเดลเปรียบเทียบกับ GA ตามขอบเขตโครงงานข้อ 1.4.3.4
+    (เปรียบเทียบผลลัพธ์การทำงานของ GA กับโมเดล optimization อื่นๆ)
+
+    หาน้ำหนักพอร์ตแบบปิด (closed-form) จากสูตร tangency portfolio:
+        w ∝ Σ⁻¹ (μ - rf)
+    แล้วบังคับ long-only (ตัดน้ำหนักติดลบทิ้งแล้ว normalize ใหม่ให้รวมเป็น 1)
+    เพราะพอร์ต DCA ของโปรเจกต์นี้ไม่รองรับการ short หุ้น
+    """
+
+    RISK_FREE_RATE = 0.02  # สมมติฐานดอกเบี้ยไร้ความเสี่ยง เท่ากับที่ใช้ใน GA
+
+    def optimize(self, stocks, target_amount=None):
+        assets = [stock.symbol if hasattr(stock, 'symbol') else str(stock) for stock in stocks]
+        if not assets:
+            return {'expected_return': 0.0, 'sharpe_ratio': 0.0, 'weights': {}}
+
+        try:
+            tickers = [f"{s}.BK" for s in assets]
+            data = yf.download(tickers, period="3y", progress=False)['Close']
+
+            if data.empty:
+                raise ValueError("ไม่สามารถดึงข้อมูลจาก Yahoo Finance ได้เลย")
+
+            if isinstance(data, pd.DataFrame):
+                valid_assets = [str(col).replace('.BK', '') for col in data.columns]
+                data = data.ffill().dropna()
+            else:
+                valid_assets = assets
+                data = data.dropna()
+
+            returns = data.pct_change().dropna()
+            num_assets = len(valid_assets)
+
+            # หุ้นตัวเดียว ไม่ต้อง optimize สัดส่วน
+            if num_assets == 1:
+                ret = float(returns.mean() * 252)
+                vol = float(returns.std() * np.sqrt(252))
+                sharpe = (ret - self.RISK_FREE_RATE) / vol if vol > 0 else 0.0
+                return {
+                    'expected_return': ret,
+                    'sharpe_ratio': sharpe,
+                    'weights': {valid_assets[0]: 1.0},
+                }
+
+            mean_returns = returns.mean().values * 252
+            cov_matrix = returns.cov().values * 252
+            excess_returns = mean_returns - self.RISK_FREE_RATE
+
+            try:
+                inv_cov = np.linalg.inv(cov_matrix)
+            except np.linalg.LinAlgError:
+                # กรณี covariance matrix ไม่สามารถหาผกผันตรงๆ ได้ (เช่นข้อมูลชนกัน)
+                inv_cov = np.linalg.pinv(cov_matrix)
+
+            raw_weights = inv_cov @ excess_returns
+
+            # บังคับ long-only: ตัดน้ำหนักติดลบทิ้ง แล้ว normalize ใหม่ให้รวมเป็น 100%
+            raw_weights = np.clip(raw_weights, 0, None)
+            if raw_weights.sum() <= 0:
+                # ถ้าทุกตัวติดลบหมด (ไม่มี asset ไหนน่าลงทุนตามสูตร) ให้ fallback เป็นน้ำหนักเท่ากัน
+                raw_weights = np.ones(num_assets)
+            weights = raw_weights / raw_weights.sum()
+
+            port_return = float(np.sum(mean_returns * weights))
+            port_vol = float(np.sqrt(weights.T @ cov_matrix @ weights))
+            port_sharpe = (port_return - self.RISK_FREE_RATE) / port_vol if port_vol > 0 else 0.0
+
+            weight_dict = {valid_assets[i]: float(weights[i]) for i in range(num_assets)}
+
+            return {
+                'expected_return': port_return,
+                'sharpe_ratio': port_sharpe,
+                'weights': weight_dict,
+            }
+        except Exception:
+            logger.exception("Mean-Variance optimizer failed")
+            equal_w = {s: 1.0 / len(assets) for s in assets} if assets else {}
+            return {'expected_return': 0.0, 'sharpe_ratio': 0.0, 'weights': equal_w}
