+    def test_mean_variance_falls_back_to_equal_weight_on_data_error(self):
+        optimizer = MeanVarianceOptimizer()
+        stocks = [type('StockRef', (), {'symbol': s})() for s in ['ADVANC', 'AOT']]
+
+        with patch('dashboard.optimizers.mean_variance.yf.download', side_effect=ValueError("no data")):
+            result = optimizer.optimize(stocks, target_amount=1000000)
+
+        self.assertEqual(result['weights'], {'ADVANC': 0.5, 'AOT': 0.5})
+        self.assertEqual(result['expected_return'], 0.0)
+        self.assertEqual(result['sharpe_ratio'], 0.0)
+
+    def test_equal_weight_falls_back_when_data_unavailable(self):
+        optimizer = EqualWeightOptimizer()
+        stocks = [type('StockRef', (), {'symbol': s})() for s in ['ADVANC', 'AOT', 'CPALL']]
+
+        with patch('dashboard.optimizers.equal_weight.yf.download', side_effect=ValueError("no data")):
+            result = optimizer.optimize(stocks, target_amount=1000000)
+
+        self.assertAlmostEqual(result['weights']['ADVANC'], 1 / 3)
+        self.assertAlmostEqual(result['weights']['AOT'], 1 / 3)
+        self.assertAlmostEqual(result['weights']['CPALL'], 1 / 3)
+
+    def test_empty_stock_list_returns_zeroed_result(self):
+        for optimizer in (MeanVarianceOptimizer(), EqualWeightOptimizer()):
+            result = optimizer.optimize([], target_amount=1000000)
+            self.assertEqual(result['weights'], {})
+            self.assertEqual(result['expected_return'], 0.0)
+            self.assertEqual(result['sharpe_ratio'], 0.0)
